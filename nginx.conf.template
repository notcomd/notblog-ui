# notblog-ui nginx 站点配置（模板）
# 由 nginx 官方镜像 entrypoint 将 /etc/nginx/templates/*.template 中的
# ${GATEWAY_UPSTREAM} 用 envsubst 渲染后写入 /etc/nginx/conf.d/。
server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip on;
    gzip_min_length 1k;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # ── SPA 路由回退（vue-router history 模式）──
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── 静态资源缓存（Vue CLI 产物文件名带 contenthash）──
    location ~* \.(js|css|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot|map)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # ── 网关反向代理：REST API（保留原路径转发，网关负责权限过滤）──
    location /api/ {
        proxy_pass http://${GATEWAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    # ── 文件直链（/files/{userId}/{guid}.ext  —— FileDev 下载端点）──
    location /files/ {
        proxy_pass http://${GATEWAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # ── SignalR WebSocket 实时通道（MessageHub / CallHub / CommunityHub）──
    location ~ ^/(MessageHub|CallHub|CommunityHub) {
        proxy_pass http://${GATEWAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}
# 后端网关（YARP）地址。开发环境留空，由 vite.config.ts 代理 /api -> http://localhost:5000；
# 生产环境构建时改为实际网关地址，例如：VUE_APP_API_BASE_URL=https://api.example.com
VUE_APP_API_BASE_URL=

# ===== WebRTC TURN 配置（语音/视频通话跨公网/严格 NAT 中继） =====
# 方式一（推荐，生产）：coturn REST API 换取限时凭证，避免把长期密钥打包进前端。
# 已实现后端端点：GET /api/turn/credentials（Message.Web.API，走网关，需登录）
VUE_APP_TURN_REST_URL=/api/turn/credentials
# 方式二（开发/自建证书）：静态 TURN。URL 例：turn:turn.example.com:3478?transport=udp
VUE_APP_TURN_URL=
VUE_APP_TURN_USERNAME=
VUE_APP_TURN_CREDENTIAL=
# 未配置以上两项时，前端自动降级为仅使用内置公共 STUN（适合内网/局域网）。
